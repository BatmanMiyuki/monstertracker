rules_version = '2';

// ════════════════════════════════════════════════════════════════
//  MonsterTracker — règles Firestore complètes
//  À coller dans : Firebase → Firestore Database → Règles → Publier
//  (remplace TOUT le contenu de la page par ce texte)
// ════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────── raccourcis ───────────
    function connecte() {
      return request.auth != null;
    }
    function moi() {
      return request.auth.uid;
    }
    // L'admin est l'utilisateur qui a « role: admin » dans son profil
    function estAdmin() {
      return connecte()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ─────────── profils utilisateurs ───────────
    match /users/{uid} {
      allow read:   if connecte();                                  // profils des amis + admin
      allow create: if connecte() && uid == moi();
      allow update: if connecte() && (uid == moi() || estAdmin());
      allow delete: if estAdmin();
    }

    // ─────────── catalogue des canettes ───────────
    match /cans/{doc} {
      allow read:   if true;                                        // visible par tout le monde
      allow create, update, delete: if estAdmin();
    }

    // ─────────── ma collection ───────────
    match /collection/{doc} {
      allow read:   if connecte();                                  // permet de voir la collection d'un ami
      allow create: if connecte() && request.resource.data.uid == moi();
      allow update: if connecte() && (request.resource.data.uid == moi() || estAdmin());
      allow delete: if connecte() && (resource.data.uid == moi() || estAdmin());
    }

    // ─────────── wishlist ───────────
    match /wishlist/{doc} {
      allow read:   if connecte();
      allow create: if connecte() && request.resource.data.uid == moi();
      allow update: if connecte() && (request.resource.data.uid == moi() || estAdmin());
      allow delete: if connecte() && (resource.data.uid == moi() || estAdmin());
    }

    // ─────────── canettes bues (statistiques) ───────────
    match /drinks/{doc} {
      allow read:   if connecte() && (resource.data.uid == moi() || estAdmin());
      allow create: if connecte() && request.resource.data.uid == moi();
      allow update, delete: if connecte() && (resource.data.uid == moi() || estAdmin());
    }

    // ─────────── 3 canettes favorites du profil ───────────
    match /favorites/{doc} {
      allow read:   if connecte();
      allow create, update: if connecte() && request.resource.data.uid == moi();
      allow delete: if connecte() && (resource.data.uid == moi() || estAdmin());
    }

    // ─────────── amis ───────────
    match /friends/{doc} {
      allow read:   if connecte();
      allow create, update: if connecte()
        && (request.resource.data.uid == moi() || request.resource.data.friendUid == moi());
      allow delete: if connecte()
        && (resource.data.uid == moi() || resource.data.friendUid == moi() || estAdmin());
    }

    // ─────────── demandes d'amis ───────────
    match /friend_requests/{doc} {
      allow read:   if connecte();
      allow create, update: if connecte()
        && (request.resource.data.from_uid == moi() || request.resource.data.to_uid == moi());
      allow delete: if connecte()
        && (resource.data.from_uid == moi() || resource.data.to_uid == moi() || estAdmin());
    }

    // ─────────── discussion entre amis ───────────
    match /chats/{doc} {
      allow read:   if connecte() && (moi() in resource.data.participants || estAdmin());
      allow create: if connecte() && request.resource.data.from_uid == moi();
      allow update: if connecte() && (moi() in resource.data.participants || estAdmin());
      allow delete: if connecte() && (moi() in resource.data.participants || estAdmin());
    }

    // ─────────── messages de contact / support ───────────
    match /messages/{doc} {
      allow read:   if connecte() && (resource.data.uid == moi() || estAdmin());
      allow create: if true;              // permet « mot de passe oublié » avant la connexion
      allow update, delete: if estAdmin();
    }

    // ─────────── annonces ───────────
    match /updates/{doc} {
      allow read:   if true;
      allow create, update, delete: if estAdmin();
    }

    // ─────────── réglages (images des séries, maintenance, code support) ───────────
    match /settings/{doc} {
      allow read:   if connecte();
      allow create, update, delete: if estAdmin();
    }
  }
}
