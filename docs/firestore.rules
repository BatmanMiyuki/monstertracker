rules_version = '2';

// ════════════════════════════════════════════════════════════════
//  MonsterTracker — RÈGLES FIRESTORE COMPLÈTES
//
//  Où les coller :
//    Console Firebase → Firestore Database → onglet « Règles »
//    → tu effaces TOUT ce qui est écrit → tu colles ce texte → PUBLIER
//
//  Ce que ça autorise :
//    • chacun gère sa collection, sa wishlist, ses favoris, ses canettes bues
//    • les profils sont lisibles (inscription + recherche d'amis)
//    • les collections d'amis sont visibles, pas modifiables
//    • seuls les admins touchent au catalogue, aux annonces et aux réglages
// ════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────── raccourcis ───────────
    function connecte() { return request.auth != null; }
    function moi()      { return request.auth.uid; }
    function estAdmin() {
      return connecte() && (
        request.auth.token.admin == true
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // ─────────── PROFILS UTILISATEURS ───────────
    match /users/{uid} {
      // lecture publique : vérifier que le pseudo / l'email ne sont pas déjà pris
      // à l'inscription, et chercher un ami par pseudo ou par code ami
      allow read: if true;
      allow create: if connecte() && uid == moi();
      allow update: if connecte() && (uid == moi() || estAdmin());
      // suppression de son propre compte depuis les Paramètres, ou par l'admin
      allow delete: if connecte() && (uid == moi() || estAdmin());
    }

    // ─────────── CATALOGUE DES CANETTES ───────────
    match /cans/{canId} {
      allow read: if resource.data.is_published == true || estAdmin();
      allow write: if estAdmin();
    }

    // ─────────── MA COLLECTION ───────────
    match /collection/{docId} {
      allow read: if connecte();                       // permet de voir la collection d'un ami
      allow create: if connecte() && request.resource.data.uid == moi();
      allow update, delete: if connecte() && (resource.data.uid == moi() || estAdmin());
    }

    // ─────────── WISHLIST ───────────
    match /wishlist/{docId} {
      allow read: if connecte() && (resource.data.uid == moi() || estAdmin());
      allow create: if connecte() && request.resource.data.uid == moi();
      allow update, delete: if connecte() && (resource.data.uid == moi() || estAdmin());
    }

    // ─────────── 3 CANETTES FAVORITES DU PROFIL ───────────
    match /favorites/{docId} {
      allow read: if connecte() && (resource.data.uid == moi() || estAdmin());
      allow create, update: if connecte() && request.resource.data.uid == moi();
      allow delete: if connecte() && (resource.data.uid == moi() || estAdmin());
    }

    // ─────────── CANETTES BUES (statistiques) ───────────
    match /drinks/{docId} {
      allow read: if connecte() && (resource.data.uid == moi() || estAdmin());
      allow create: if connecte() && request.resource.data.uid == moi();
      allow update, delete: if connecte() && (resource.data.uid == moi() || estAdmin());
    }

    // ─────────── AMIS ───────────
    match /friends/{docId} {
      // l'admin doit pouvoir lire (espace support) ; l'utilisateur seulement ses amitiés
      allow read: if connecte() && (resource.data.uid == moi() || resource.data.friendUid == moi() || estAdmin());
      // on écrit les DEUX documents de l'amitié (le mien + celui de l'ami)
      allow create, update: if connecte()
        && (request.resource.data.uid == moi() || request.resource.data.friendUid == moi());
      allow delete: if connecte()
        && (resource.data.uid == moi() || resource.data.friendUid == moi() || estAdmin());
    }

    // ─────────── DEMANDES D'AMIS ───────────
    match /friend_requests/{docId} {
      allow read: if connecte() && (resource.data.from_uid == moi() || resource.data.to_uid == moi() || estAdmin());
      allow create: if connecte() && request.resource.data.from_uid == moi();
      allow update, delete: if connecte()
        && (resource.data.from_uid == moi() || resource.data.to_uid == moi() || estAdmin());
    }

    // ─────────── DISCUSSION ENTRE AMIS ───────────
    match /chats/{docId} {
      allow read: if connecte() && (moi() in resource.data.participants || estAdmin());
      allow create: if connecte() && moi() in request.resource.data.participants;
      allow update, delete: if connecte() && (moi() in resource.data.participants || estAdmin());
    }

    // ─────────── MESSAGES AU SUPPORT ───────────
    match /messages/{docId} {
      // « Mot de passe oublié » peut être envoyé sans être connecté (uid = null)
      allow create: if (connecte() && request.resource.data.uid == moi()) || request.resource.data.uid == null;
      allow read: if estAdmin() || (connecte() && resource.data.uid == moi());
      allow update, delete: if estAdmin() || (connecte() && resource.data.uid == moi());
    }

    // ─────────── ANNONCES ───────────
    match /updates/{docId} {
      allow read: if true;
      allow write: if estAdmin();
    }

    // ─────────── RÉGLAGES (photos des séries, maintenance, code support) ───────────
    match /settings/{docId} {
      allow read: if true;
      allow write: if estAdmin();
    }

    // ─────────── TOUT LE RESTE EST INTERDIT ───────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
